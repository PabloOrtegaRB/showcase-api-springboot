    "/api/v1/solicitudes": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Lista solicitudes con filtros y paginación (más recientes primero)",
        "operationId": "listar",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "RECIBIDA",
                "EN_PROCESO",
                "COMPLETADA",
                "CANCELADA"
              ]
            }
          },
          {
            "name": "prioridad",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "BAJA",
                "MEDIA",
                "ALTA",
                "CRITICA"
              ]
            }
          },
          {
            "name": "clienteId",
            "in": "query",
            "description": "Id del cliente",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "desde",
            "in": "query",
            "description": "Creadas desde esta fecha (AAAA-MM-DD, inclusive)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "description": "Creadas hasta esta fecha (AAAA-MM-DD, inclusive)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Página, desde 0",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Elementos por página (1 a 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaSolicitudSalida"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Registra una solicitud (el cliente debe estar activo)",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SolicitudSalida"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/productos": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Lista productos con filtros y paginación",
        "operationId": "listar_1",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Texto en nombre o SKU",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "description": "Categoría exacta",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "REPUESTOS",
                "HERRAMIENTAS",
                "CLIMATIZACION",
                "ELECTRICIDAD",
                "SEGURIDAD"
              ]
            }
          },
          {
            "name": "activo",
            "in": "query",
            "description": "true: solo activos · false: solo inactivos",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Página, desde 0",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Elementos por página (1 a 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaProductoSalida"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Productos"
        ],
        "summary": "Crea un producto (el SKU no puede repetirse)",
        "operationId": "crear_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoSalida"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clientes": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Lista clientes con filtros y paginación",
        "operationId": "listar_2",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Texto en razón social, correo o RUT",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "comuna",
            "in": "query",
            "description": "Comuna exacta",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "activo",
            "in": "query",
            "description": "true: solo activos · false: solo inactivos",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Página, desde 0",
