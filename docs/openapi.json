{
  "openapi": "3.1.0",
  "info": {
    "title": "API Valdora (demostrativa)",
    "description": "API REST de clientes, productos y solicitudes de servicio, con validaciones, paginación, filtros y errores en formato RFC 9457. **Proyecto demostrativo — desarrollo propio, no asociado a un cliente real.** Todos los datos son ficticios.",
    "contact": {
      "name": "Pablo Ortega Rubio",
      "url": "https://github.com/PabloOrtegaRB"
    },
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8092",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Solicitudes",
      "description": "Solicitudes de servicio y su ciclo de vida (datos ficticios)"
    },
    {
      "name": "Clientes",
      "description": "Empresas que solicitan servicios (datos ficticios)"
    },
    {
      "name": "Productos",
      "description": "Catálogo de repuestos, herramientas y equipos (datos ficticios)"
    }
  ],
