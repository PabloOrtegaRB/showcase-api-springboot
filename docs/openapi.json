  },
  "components": {
    "schemas": {
      "ProductoEntrada": {
        "type": "object",
        "description": "Datos para crear o actualizar un producto",
        "properties": {
          "sku": {
            "type": "string",
            "example": "REP-1001",
            "minLength": 1,
            "pattern": "^[A-Za-z]{3}-\\d{4}$"
          },
          "nombre": {
            "type": "string",
            "example": "Filtro de aire 24x24 pulgadas",
            "maxLength": 120,
            "minLength": 0
          },
          "categoria": {
            "type": "string",
            "enum": [
              "REPUESTOS",
              "HERRAMIENTAS",
              "CLIMATIZACION",
              "ELECTRICIDAD",
              "SEGURIDAD"
            ]
          },
          "precio": {
            "type": "number",
            "description": "Precio en pesos chilenos, sin decimales",
            "example": 12990,
            "minimum": 1
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "example": 48,
            "minimum": 0
          },
          "activo": {
            "type": "boolean",
            "description": "Si no se indica, el producto queda activo",
            "example": true
          }
        },
        "required": [
          "categoria",
          "nombre",
          "precio",
          "sku",
          "stock"
        ]
      },
      "ProductoSalida": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sku": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "REPUESTOS",
              "HERRAMIENTAS",
              "CLIMATIZACION",
              "ELECTRICIDAD",
              "SEGURIDAD"
            ]
          },
          "precio": {
            "type": "number"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "ClienteEntrada": {
        "type": "object",
        "description": "Datos para crear o actualizar un cliente",
        "properties": {
          "rut": {
            "type": "string",
            "example": "76.100.000-4",
            "minLength": 1
          },
          "razonSocial": {
            "type": "string",
            "example": "Bodegas Arrayán Sur SpA",
            "maxLength": 120,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "contacto@arrayan-sur.example",
            "maxLength": 120,
            "minLength": 0
          },
          "telefono": {
            "type": "string",
            "example": "+56 9 5555 0100",
            "pattern": "^$|^\\+?56\\s?9\\s?\\d{4}\\s?\\d{4}$"
          },
          "comuna": {
            "type": "string",
            "example": "Santiago",
            "maxLength": 40,
            "minLength": 0
          },
          "activo": {
            "type": "boolean",
            "description": "Si no se indica, el cliente queda activo",
            "example": true
          }
        },
        "required": [
          "comuna",
          "email",
          "razonSocial",
          "rut"
        ]
      },
      "ClienteSalida": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "rut": {
            "type": "string"
          },
          "razonSocial": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "comuna": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          },
          "fechaRegistro": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "SolicitudEntrada": {
        "type": "object",
        "description": "Datos para registrar una solicitud de servicio",
        "properties": {
          "clienteId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "productoId": {
            "type": "integer",
            "format": "int64",
            "description": "Producto relacionado (opcional)",
            "example": 3
          },
          "titulo": {
            "type": "string",
            "example": "Mantención preventiva de chiller",
            "maxLength": 120,
            "minLength": 0
          },
          "descripcion": {
            "type": "string",
            "example": "Revisión trimestral del equipo de la planta 2.",
            "maxLength": 1000,
            "minLength": 0
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "BAJA",
              "MEDIA",
              "ALTA",
              "CRITICA"
            ]
          }
        },
        "required": [
          "clienteId",
          "prioridad",
          "titulo"
        ]
      },
      "ClienteResumen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "razonSocial": {
            "type": "string"
          }
        }
      },
      "ProductoResumen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sku": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        }
      },
      "SolicitudSalida": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "titulo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "BAJA",
              "MEDIA",
              "ALTA",
              "CRITICA"
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "RECIBIDA",
              "EN_PROCESO",
              "COMPLETADA",
              "CANCELADA"
            ]
          },
          "estadosSiguientes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "RECIBIDA",
                "EN_PROCESO",
                "COMPLETADA",
                "CANCELADA"
              ]
            },
            "uniqueItems": true
          },
          "cliente": {
            "$ref": "#/components/schemas/ClienteResumen"
          },
          "producto": {
            "$ref": "#/components/schemas/ProductoResumen"
          },
          "comentarioEstado": {
            "type": "string"
          },
          "creadaEn": {
            "type": "string",
            "format": "date-time"
          },
          "actualizadaEn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CambioEstadoEntrada": {
        "type": "object",
        "description": "Cambio de estado de una solicitud",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "RECIBIDA",
              "EN_PROCESO",
              "COMPLETADA",
              "CANCELADA"
            ]
          },
          "comentario": {
            "type": "string",
            "example": "Técnico asignado para el martes.",
            "maxLength": 300,
            "minLength": 0
          }
        },
        "required": [
          "estado"
        ]
      },
      "PaginaSolicitudSalida": {
        "type": "object",
        "properties": {
          "contenido": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SolicitudSalida"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamano": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PaginaProductoSalida": {
        "type": "object",
        "properties": {
          "contenido": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductoSalida"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamano": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PaginaClienteSalida": {
